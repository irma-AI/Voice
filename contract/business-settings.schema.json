{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "business-settings",
  "title": "What the Portal tells the core about one Business at call start",
  "description": "The one definition of the settings shape. The Portal serves it (portal/accounts/models.py as_settings) and the core reads it (VOI-25); tests/portal/test_settings_contract.py fails when either side drifts. The AI notice is not a setting and has no property here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "facts", "languages"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "facts": { "type": "string", "maxLength": 5000 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["sv", "en"] }
    },
    "modules": {
      "description": "The Business's Modules (MCP servers), optional. A remote Module has a url; a local one a command, which the core runs only where self-hosting allows it (ALLOW_LOCAL_MODULES). The Portal's Modules page (VOI-28) fills it.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "url": { "type": "string", "pattern": "^https?://", "maxLength": 2000 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "command"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "command": { "type": "string", "minLength": 1, "maxLength": 500 },
              "args": {
                "type": "array",
                "maxItems": 20,
                "items": { "type": "string", "maxLength": 500 }
              }
            }
          }
        ]
      }
    }
  }
}
