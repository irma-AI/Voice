# Copy to .env for local runs. Every value here works
# locally as is. Real secrets never go in this file or anywhere in the repo (CLAUDE.md § Hard rules 6).
# Add one line per setting the app reads, with a working local default.

# Gemini API key for `make up` (aistudio.google.com): the one value with no working default. Set it in .env; it never goes here.
GOOGLE_API_KEY=

# Where the core gets a Business's settings (voice/settings.py) and how it checks a Portal call link: the Portal's address and the secret both share.
# `make up` refuses to start without CORE_SECRET: only a link made by the Portal (its test call button or a Business's call link) opens a call.
# Evals use a settings file of their own (SETTINGS_FILE, set by tests/evals/run.py); never set it here, it would clash with SETTINGS_URL.
SETTINGS_URL=http://localhost:8000
CORE_SECRET=local

# Self-hosting's switch, read by both the core (voice/modules.py) and the Portal: with 1 a Business may add a local Module (a program on this machine) or a Module at an http or private address. Hosted never sets it: the Portal then refuses them in its form and leaves them out of the settings, and the core skips and logs them.
# ALLOW_LOCAL_MODULES=1

# The Portal (`make portal-up`): every value works locally as is. Outside a local run (no DEBUG) the Portal refuses to start
# without ENVIRONMENT (local or production), DJANGO_SECRET_KEY, ALLOWED_HOSTS, PORTAL_URL (where invite links point), EMAIL_HOST, EMAIL_FROM, CORE_URL (the core's call page, where the test call button leads) and CORE_SECRET (the shared secret the core sends to read a Business's settings, and that signs the call tickets); set those in the host's environment.
DEBUG=1
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5432/portal
PORTAL_URL=http://localhost:8000
# Local mail prints to the console (invite and reset links appear in the Portal's output).
# EMAIL_HOST=  EMAIL_PORT=587  EMAIL_HOST_USER=  EMAIL_HOST_PASSWORD=  EMAIL_FROM=
ENVIRONMENT=local
CORE_SECRET=local
# The clock the Portal shows times on, a name from the tz database (default UTC; the hosted Portal sets Europe/Stockholm). Stored times are always UTC; this only changes what a page shows. A name that is not a time zone stops the Portal.
# TIME_ZONE=Europe/Stockholm
# The email of the one Account that may open the totals page (/totals/). Unset: nobody can.
# SUPER_ADMIN_EMAIL=you@example.com
# Where the landing page's Request access button sends an email. Unset: the button is hidden.
# CONTACT_EMAIL=hello@example.com
# Where the core's call page is, for the Portal's test call button (`make up`; hosted: the core's public address, required outside a local run).
CORE_URL=http://localhost:7860
