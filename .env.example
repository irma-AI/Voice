# Copy to .env for local runs. Every value here works
# locally as is. Real secrets never go in this file or anywhere in the repo (CLAUDE.md § Hard rules 6).
# Add one line per setting the app reads, with a working local default.

# Gemini API key for `make up` (aistudio.google.com): the one value with no working default. Set it in .env; it never goes here.
GOOGLE_API_KEY=

# Login for the call page (HTTP Basic): the name defaults to "voice". `make up` refuses to start without a password.
# Local value only; the deployed one is set in Dokploy.
VOICE_USER=voice
VOICE_PASSWORD=local

# Where the core gets a Business's settings (voice/settings.py): set exactly one source, or every call is refused out loud.
# Locally: a file in the settings shape. Hosted: the Portal's address, with the same CORE_SECRET the Portal holds and the id of the Business whose calls this core answers.
SETTINGS_FILE=tests/evals/business.json
# SETTINGS_URL=http://localhost:8000
# BUSINESS_ID=1
# CORE_SECRET=local

# The Portal (`make portal-up`): every value works locally as is. Outside a local run (no DEBUG) the Portal refuses to start
# without ENVIRONMENT (local or production), DJANGO_SECRET_KEY, ALLOWED_HOSTS, PORTAL_URL (where invite links point), EMAIL_HOST, EMAIL_FROM and CORE_SECRET (the shared secret the core sends to read a Business's settings); set those in the host's environment.
DEBUG=1
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5432/portal
PORTAL_URL=http://localhost:8000
# Local mail prints to the console (invite and reset links appear in the Portal's output).
# EMAIL_HOST=  EMAIL_PORT=587  EMAIL_HOST_USER=  EMAIL_HOST_PASSWORD=  EMAIL_FROM=
ENVIRONMENT=local
CORE_SECRET=local
